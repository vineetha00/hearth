# Copy to .env and `export $(grep -v '^#' .env | xargs)` (or use your shell's dotenv loader).

# --- Language model -------------------------------------------------------
# auto       Amazon Bedrock if AWS credentials resolve, otherwise the offline fallback (default)
# bedrock    prefer Bedrock (per-call fallback still applies if a request fails)
# heuristic  never call AWS (tests, offline demos)
HEARTH_LLM=auto
AWS_REGION=us-west-2
# Any Bedrock model your account can invoke via the Converse API (inference-profile IDs work too).
# The default below is a guess at a current Claude ID: check the Bedrock console and set yours.
HEARTH_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Server ---------------------------------------------------------------
HEARTH_HOST=127.0.0.1     # use 0.0.0.0 when serving a public hostname (localhost binding rejects other Host headers)
HEARTH_PORT=8765
HEARTH_DB=data/hearth.db
HEARTH_TZ=America/Los_Angeles
# HEARTH_NOW=2026-10-20T20:30:00   # pin the clock for repeatable demos/tests

# --- Simulator ------------------------------------------------------------
HEARTH_MCP_URL=http://127.0.0.1:8765/mcp
SIM_PORT=8080
